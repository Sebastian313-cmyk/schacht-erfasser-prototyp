{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flutter App",
			"type": "shell",
			"command": "flutter run",
			"isBackground": false,
			"problemMatcher": [
				"$dart"
			],
			"group": "build"
		},
		{
			"label": "Run Flutter App (Chrome)",
			"type": "shell",
			"command": "flutter run -d chrome",
			"isBackground": false,
			"group": "build"
		}
	]
}